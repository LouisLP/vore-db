# Copy to .env before running `docker compose up -d`.
# Both Docker Compose and the backend (drizzle-kit) read this file.
POSTGRES_USER=vore
POSTGRES_PASSWORD=vore
POSTGRES_DB=vore
POSTGRES_PORT=5433

# Host-side connection string; POSTGRES_PORT is the published port, not 5432.
DATABASE_URL=postgres://vore:vore@localhost:5433/vore
